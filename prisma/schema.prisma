// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  LINKER
  WRITER
  TEAM_LEAD
  PRODUCT_RESEARCHER
  GUEST
}

enum ArticleStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  APPROVED
  REDO
  REDIRECTED
}

enum LinkStatus {
  REQUESTED
  ACCEPTED
  CANCELED
  ISSUE
  NEED_TO_CHECK
  PRESELL_PAGE
  REDIRECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  ARTICLE_SUGGESTION
  LINK_ISSUE
  APPROVAL_GRANTED
  PRODUCT_ADDED
}

enum NoticeCategory {
  IMPORTANT
  GENERAL
  SUGGESTION
  URGENT
  ANNOUNCEMENT
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id                    String   @id @default(cuid())
  name                  String
  email                 String   @unique
  role                  Role?
  approved              Boolean  @default(false)
  hasLeftCompany        Boolean  @default(false)
  commissionToPartyFund Boolean  @default(false)
  image                 String?
  allowLinkLogAccess    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Site access for writers (assigned by Admin)
  siteAccess SiteAccess[]

  // Products added/updated by this user
  productsAdded   Product[] @relation("ProductAddedBy")
  productsUpdated Product[] @relation("ProductUpdatedBy")

  // Articles written
  articles Article[] @relation("ArticleWriter")

  // Links added by this linker
  linksAdded   LinkLog[] @relation("LinkAddedBy")
  linksUpdated LinkLog[] @relation("LinkUpdatedBy")

  // Team Lead: articles approved or reviewed
  articleReviews ArticleReview[] @relation("ReviewedBy")

  // Team Lead: special approvals granted
  specialApprovals SpecialApproval[] @relation("ApprovedBy")

  // Notifications received
  notifications Notification[] @relation("NotificationRecipient")

  // Notifications sent (by team lead)
  notificationsSent Notification[] @relation("NotificationSender")

  // Team Lead assigned to this user (for Writers) — primary/legacy FK kept in sync with first WriterTeamLead
  teamLeadId String?
  teamLead   User?   @relation("TeamMembers", fields: [teamLeadId], references: [id])

  // Writers assigned to this Team Lead (legacy 1-to-many)
  teamMembers User[] @relation("TeamMembers")

  // Many-to-many Team Lead assignments (one writer can have multiple TLs)
  writerTeamLeads WriterTeamLead[] @relation("WriterToTeamLeads")
  teamLeadWriters WriterTeamLead[] @relation("TeamLeadToWriters")

  // Article histories updated by this user
  articleHistories ArticleHistory[] @relation("ArticleHistoryUpdatedBy")
  linkHistories    LinkHistory[]    @relation("LinkHistoryUpdatedBy")

  // Notice board
  noticesCreated        Notice[]               @relation("NoticeCreatedBy")
  noticeAcknowledgments NoticeAcknowledgment[] @relation("NoticeAcknowledgedBy")

  // Trendmap products added manually by this user
  trendmapProductsAdded TrendmapProduct[] @relation("TrendmapProductAddedBy")
}

// Many-to-many join between Writer and Team Lead (one writer can have multiple TLs)
model WriterTeamLead {
  id         String   @id @default(cuid())
  writerId   String
  teamLeadId String
  assignedAt DateTime @default(now())

  writer   User @relation("WriterToTeamLeads", fields: [writerId], references: [id], onDelete: Cascade)
  teamLead User @relation("TeamLeadToWriters", fields: [teamLeadId], references: [id], onDelete: Cascade)

  @@unique([writerId, teamLeadId])
  @@index([writerId])
  @@index([teamLeadId])
}

// ─────────────────────────────────────────────
// SITE
// ─────────────────────────────────────────────

model Site {
  id                   String   @id @default(cuid())
  name                 String
  url                  String?
  bridgeUrl            String?  @db.Text
  allowCountrySpecific Boolean  @default(false)
  createdAt            DateTime @default(now())

  categories      Category[]
  products        Product[]
  siteAccess      SiteAccess[]
  commissionSales CommissionSale[]
}

// Site access and partial roles (assigned by Super Admin / Admin)
model SiteAccess {
  id            String   @id @default(cuid())
  userId        String
  siteId        String
  role          Role?    @default(WRITER) // Primary role on this site
  roles         String? // Comma-separated roles if multiple (e.g. "LINKER,WRITER,TEAM_LEAD")
  canAddProduct Boolean  @default(false)
  canAddLink    Boolean  @default(false)
  canWrite      Boolean  @default(false)
  canReview     Boolean  @default(false)
  grantedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  site Site @relation(fields: [siteId], references: [id])

  @@unique([userId, siteId])
}

// ─────────────────────────────────────────────
// CATEGORY
// ─────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  sites    Site[]
  products Product[]
}

// ─────────────────────────────────────────────
// PRODUCT
// ─────────────────────────────────────────────

model Product {
  id              String    @id @default(cuid())
  name            String
  slug            String?   @db.Text
  country         String?   @db.Text
  isNative        Boolean   @default(false)
  source          String? // Affiliate, Competitor, Social Media/Native, Source

  siteId          String
  targetSites     String?   @db.Text
  categoryId      String
  productCategory String?   @db.Text // Defined category for the product (e.g. Skincare, Supplements)
  trendLink       String?   @db.Text
  trendLevel      String?   @default("HIGH") // HIGH, MODERATE, LOW
  affiliateName   String?   @db.Text // Selected from Affiliate dropdown
  previewLink     String?   @db.Text
  remarks         String?   @db.Text
  addedById       String
  addedAt         DateTime  @default(now())
  updatedById     String?
  updatedAt       DateTime? @updatedAt

  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  addedBy   User     @relation("ProductAddedBy", fields: [addedById], references: [id])
  updatedBy User?    @relation("ProductUpdatedBy", fields: [updatedById], references: [id])

  article         Article?
  linkLogs        LinkLog[]
  commissionSales CommissionSale[]

  @@index([siteId, addedAt])
  @@index([name])
  @@index([categoryId])
  @@index([addedById])
}

// ─────────────────────────────────────────────
// ARTICLE
// ─────────────────────────────────────────────

model Article {
  id                           String        @id @default(cuid())
  productId                    String        @unique
  writerId                     String?
  country                      String?       @db.Text
  status                       ArticleStatus @default(PENDING)
  articleLink                  String?       @db.Text
  startedAt                    DateTime? // Set when status → IN_PROGRESS
  completedAt                  DateTime? // Set when status → COMPLETED
  writingTimeMin               Int? // Calculated: completedAt - startedAt in minutes
  updateTimeMin                Int? // Calculated: cumulative minutes spent on revisions/redo
  priority                     Priority      @default(MEDIUM)
  specialApprovalRequested     Boolean       @default(false)
  specialApprovalRequestReason String?       @db.Text
  updatedAt                    DateTime      @updatedAt
  productCreatedAt             DateTime? // Auto-set when article is completed

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  writer  User?   @relation("ArticleWriter", fields: [writerId], references: [id])

  reviews         ArticleReview[]
  specialApproval SpecialApproval?
  history         ArticleHistory[]

  @@index([writerId, status])
  @@index([status])
  @@index([updatedAt])
}

// ─────────────────────────────────────────────
// ARTICLE REVIEW (Team Lead review/suggestions)
// ─────────────────────────────────────────────

model ArticleReview {
  id           String   @id @default(cuid())
  articleId    String
  reviewedById String
  suggestion   String?  @db.Text
  approved     Boolean  @default(false)
  reviewedAt   DateTime @default(now())

  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewedBy User    @relation("ReviewedBy", fields: [reviewedById], references: [id])
}

// ─────────────────────────────────────────────
// SPECIAL APPROVAL (complete without article link)
// ─────────────────────────────────────────────

model SpecialApproval {
  id           String   @id @default(cuid())
  articleId    String   @unique
  approvedById String
  writerName   String // Denormalized for reporting
  productName  String // Denormalized for reporting
  reason       String   @db.Text
  approvedAt   DateTime @default(now())

  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  approvedBy User    @relation("ApprovedBy", fields: [approvedById], references: [id])
}

// ─────────────────────────────────────────────
// LINK LOG
// ─────────────────────────────────────────────

model LinkLog {
  id             String     @id @default(cuid())
  productId      String
  addedById      String
  updatedById    String?
  bridgePageLink String?    @db.Text
  buyLink        String?    @db.Text
  affiliateName  String     @db.Text
  affiliateLink  String     @db.Text
  geos           LinkGeo[]
  status         LinkStatus @default(REQUESTED)
  linkerRemarks  String?    @db.Text
  addedAt        DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedBy   User          @relation("LinkAddedBy", fields: [addedById], references: [id])
  updatedBy User?         @relation("LinkUpdatedBy", fields: [updatedById], references: [id])
  history   LinkHistory[]

  @@index([productId, addedAt])
  @@index([addedAt])
  @@index([addedById, addedAt])
  @@index([addedById, status])
  @@index([status])
}

// GEO entries for a link (multi-select support)
model LinkGeo {
  id            String  @id @default(cuid())
  linkLogId     String
  geo           String // e.g. "US", "UK", "CA"
  affiliateLink String? @db.Text
  affiliateName String?

  linkLog LinkLog @relation(fields: [linkLogId], references: [id], onDelete: Cascade)

  @@unique([linkLogId, geo])
}

// ─────────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  senderId    String
  type        NotificationType
  message     String           @db.Text
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id])
  sender    User @relation("NotificationSender", fields: [senderId], references: [id])

  @@index([recipientId, isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ARTICLE HISTORY
// ─────────────────────────────────────────────

model ArticleHistory {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  updatedById String
  updatedBy   User     @relation("ArticleHistoryUpdatedBy", fields: [updatedById], references: [id])
  oldStatus   String?
  newStatus   String?
  oldLink     String?  @db.Text
  newLink     String?  @db.Text
  notes       String?  @db.Text
  updatedAt   DateTime @default(now())

  @@index([articleId])
  @@index([updatedById])
  @@index([updatedAt])
}

model AffiliateName {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Geo {
  id        String   @id @default(cuid())
  code      String   @unique
  createdAt DateTime @default(now())
}

model LinkHistory {
  id               String   @id @default(cuid())
  linkLogId        String
  linkLog          LinkLog  @relation(fields: [linkLogId], references: [id], onDelete: Cascade)
  updatedById      String
  updatedBy        User     @relation("LinkHistoryUpdatedBy", fields: [updatedById], references: [id])
  oldBridgeLink    String?  @db.Text
  newBridgeLink    String?  @db.Text
  oldBuyLink       String?  @db.Text
  newBuyLink       String?  @db.Text
  oldAffiliateLink String?  @db.Text
  newAffiliateLink String?  @db.Text
  oldStatus        String?
  newStatus        String?
  oldRemarks       String?  @db.Text
  newRemarks       String?  @db.Text
  updatedAt        DateTime @default(now())

  @@index([linkLogId])
  @@index([updatedById])
  @@index([updatedAt])
}

model Notice {
  id          String         @id @default(cuid())
  title       String
  content     String         @db.Text
  category    NoticeCategory @default(GENERAL)
  targetRoles String?        @default("ALL")
  createdById String
  createdBy   User           @relation("NoticeCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  acknowledgments NoticeAcknowledgment[]
}

model NoticeAcknowledgment {
  id       String   @id @default(cuid())
  noticeId String
  notice   Notice   @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation("NoticeAcknowledgedBy", fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime @default(now())

  @@unique([noticeId, userId])
}

// ─────────────────────────────────────────────
// COMMISSION SETTING
// ─────────────────────────────────────────────

model CommissionSetting {
  id       String @id @default(cuid())
  category String // "NUTRA" | "ECOM"
  saleType String // "FIRST_SALE" | "RESALE"
  rateType String @default("FIXED") // "FIXED" or "PERCENTAGE" (%)
  currency String @default("NPR")

  linker    Float @default(0)
  writer    Float @default(0)
  tl        Float @default(0)
  seo       Float @default(0)
  bonusPool Float @default(0)
  partyFund Float @default(0)
  total     Float @default(0)

  notes       String?  @db.Text
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([category, saleType])
}

// ─────────────────────────────────────────────
// COMMISSION SALE (1st Sale & Resale records per product)
// ─────────────────────────────────────────────

model CommissionSale {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  saleType String   @default("FIRST_SALE") // "FIRST_SALE" | "RESALE"
  saleDate DateTime @default(now())

  // Beneficiaries linked at time of sale
  writerId     String?
  writerName   String?
  linkerId     String?
  linkerName   String?
  teamLeadId   String?
  teamLeadName String?

  // Payment status
  paymentStatus String    @default("PENDING") // "PENDING" | "PAID"
  paidAt        DateTime?
  writerPaid    Boolean   @default(false)
  writerPaidAt  DateTime?
  linkerPaid    Boolean   @default(false)
  linkerPaidAt  DateTime?
  tlPaid        Boolean   @default(false)
  tlPaidAt      DateTime?

  // Commission amounts snapshot in Rs from CommissionSetting
  amount                   Float   @default(0) // Total commission in Rs
  linkerAmount             Float   @default(0)
  writerAmount             Float   @default(0)
  tlAmount                 Float   @default(0)
  seoAmount                Float   @default(0)
  bonusAmount              Float   @default(0)
  partyAmount              Float   @default(0)
  writerLeftCompany        Boolean @default(false)
  writerTransferredToParty Float   @default(0)

  notes       String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([siteId])
  @@index([saleType, productId])
  @@index([writerId])
  @@index([linkerId])
  @@index([teamLeadId])
  @@index([paymentStatus])
  @@index([saleDate])
  @@index([writerPaid])
  @@index([linkerPaid])
  @@index([tlPaid])
}

// ─────────────────────────────────────────────
// TRENDMAP PRODUCT
// ─────────────────────────────────────────────

model TrendmapProduct {
  id               String   @id @default(cuid())
  name             String
  productUrl       String?  @db.Text
  competitor       String?
  searchDemand     String? // e.g. "26 / 100" or "Not analyzed"
  demandScore      Int? // e.g. 26
  demandLevel      String?  @default("NOT_ANALYZED") // "HIGH", "MODERATE", "LOW", "NOT_ANALYZED"
  category         String?
  market           String?  @default("United (US)")
  modifiedDate     String? // e.g. "Jan 19, 2026"
  discoveredDate   String? // e.g. "Oct 6"
  researchedBy     String? // User who researched the product in Trendmap
  notes            String?  @db.Text
  status           String   @default("PENDING") // "PENDING" | "ADDED" | "DISMISSED"
  addedToCatalog   Boolean  @default(false)
  catalogProductId String?
  addedById        String?
  addedBy          User?    @relation("TrendmapProductAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([name])
  @@index([competitor])
  @@index([status])
  @@index([demandLevel])
}

// ─────────────────────────────────────────────
// SYSTEM SETTING (Global System Key-Value configuration)
// ─────────────────────────────────────────────

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
